NODE_ENV=development
PORT=4000

# Local MongoDB. For production use your Atlas string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27018/doctor-tracker

# Generate with: openssl rand -base64 48   (must match client JWT_SECRET)
JWT_SECRET=1RKNt0KFu0cowY4HBdxJWVApyIMJBC66WSJV8jucemIPtRJhUHYrLaTZVLxm
JWT_EXPIRES_IN=8h
COOKIE_NAME=dt_token

# The Next.js app origin (Vercel URL in production)
CLIENT_ORIGIN=http://localhost:3001

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_VIEWER_EMAIL=viewer@doctortracker.dev
SEED_VIEWER_PASSWORD=Viewer@12345
